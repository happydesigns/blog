{
  "name": "@happydesigns/blog",
  "version": "0.1.0",
  "description": "Configurable publication capability for Nuxt Content websites.",
  "keywords": [
    "nuxt",
    "nuxt-module",
    "nuxt-content",
    "nuxt-ui",
    "blog",
    "rss",
    "atom"
  ],
  "homepage": "https://github.com/happydesigns/blog#readme",
  "bugs": {
    "url": "https://github.com/happydesigns/blog/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/happydesigns/blog.git"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./core": {
      "types": "./dist/core.d.mts",
      "import": "./dist/core.mjs"
    },
    "./content": {
      "types": "./dist/content.d.mts",
      "import": "./dist/content.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ],
      "core": [
        "./dist/core.d.mts"
      ],
      "content": [
        "./dist/content.d.mts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "ARCHITECTURE.md",
    "LICENSE"
  ],
  "workspaces": [
    "playground"
  ],
  "scripts": {
    "prepack": "nuxt-module-build build",
    "prepare": "nuxt-module-build prepare && nuxt-module-build build",
    "dev": "pnpm dev:prepare && nuxt dev playground",
    "dev:build": "nuxt build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playground",
    "release": "pnpm lint && pnpm typecheck && pnpm test && pnpm prepack && changelogen --release && npm publish && git push --follow-tags",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm prepack && pnpm dev:build"
  },
  "dependencies": {
    "@nuxt/kit": "^4.5.2"
  },
  "devDependencies": {
    "@nuxt/content": "^3.15.0",
    "@nuxt/eslint-config": "^1.17.0",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.5.2",
    "@nuxt/test-utils": "^4.1.0",
    "@nuxt/ui": "^4.10.0",
    "@types/node": "latest",
    "better-sqlite3": "^12.11.1",
    "changelogen": "^0.6.2",
    "eslint": "^10.8.1",
    "nuxt": "^4.5.2",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "unbuild": "^3.6.1",
    "vitest": "^4.1.10",
    "vue": "^3.5.41",
    "vue-tsc": "^3.3.9",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@nuxt/content": ">=3.15.0 <4",
    "@nuxt/ui": ">=4.10.0 <5",
    "nuxt": ">=4.5.1 <6",
    "vue": ">=3.5.0 <4",
    "zod": ">=4.0.0 <5"
  },
  "engines": {
    "node": "^22.19.0 || ^24.11.0 || >=26.0.0"
  },
  "packageManager": "pnpm@11.20.0",
  "publishConfig": {
    "access": "public"
  }
}
